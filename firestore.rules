rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything the app owns lives under users/{uid}. A signed-in user can reach
    // their own subtree and nothing else. Cloud Functions use the Admin SDK and
    // bypass these rules, which is how transcripts get written.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
