# Firebase WEB config.
#
# These are PUBLIC identifiers. They ship in the client bundle of every Firebase web
# app and cannot be hidden — security comes from firestore.rules / storage.rules and a
# restricted OAuth consent screen. They live here so anyone forking this repo points at
# their own project rather than someone else's.
#
# The speech server's hostname and API key are NOT in this file and never will be.
# They are Secret Manager secrets read only inside Cloud Functions. Anything with a
# VITE_ prefix is inlined into the browser bundle at build time.

# AUTH_DOMAIN stays as the <project>.firebaseapp.com default, because this app signs in
# with a popup rather than a redirect — see src/stores/auth.ts.
#
# If you ever switch to signInWithRedirect, this has to change. Redirect bounces through
# <authDomain>/__/auth/handler and that handler has to hand the credential back to the
# app; when the two are different origins, Safari's tracking prevention blocks it and
# sign-in fails silently on an installed PWA — nothing throws and no user is created.
# The fix is to point this at the hosting domain (Firebase Hosting serves
# /__/auth/handler there too) AND add https://<authDomain>/__/auth/handler to the OAuth
# client's authorized redirect URIs, which the auto-created client does not list.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-marginalia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-marginalia
VITE_FIREBASE_STORAGE_BUCKET=demo-marginalia.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Point the SDK at the local emulator suite. The demo- project prefix makes the
# emulators refuse to touch a real project, so this is safe by construction.
VITE_USE_EMULATORS=true
