# Firebase WEB config.
#
# These are PUBLIC identifiers. They ship in the client bundle of every Firebase web
# app and cannot be hidden — security comes from firestore.rules / storage.rules and a
# restricted OAuth consent screen. They live here so anyone forking this repo points at
# their own project rather than someone else's.
#
# The speech server's hostname and API key are NOT in this file and never will be.
# They are Secret Manager secrets read only inside Cloud Functions. Anything with a
# VITE_ prefix is inlined into the browser bundle at build time.

# AUTH_DOMAIN must be the SAME ORIGIN the app is served from, not the
# <project>.firebaseapp.com default the Firebase console hands you.
#
# `signInWithRedirect` bounces through <authDomain>/__/auth/handler, which then has to
# hand the credential back to the app. Safari's tracking prevention blocks that when the
# two are different origins: getRedirectResult() returns nothing, onAuthStateChanged
# fires null, and the user lands back on the sign-in screen having apparently done
# nothing. No error is thrown anywhere.
#
# It only bites the installed PWA. A browser tab uses signInWithPopup, which can hand
# the credential across origins — so this looks like it works right up until you install
# to the Home Screen. Verified broken then fixed on a real iPhone, 2026-08-21.
#
# Firebase Hosting serves /__/auth/handler on the hosting domain too, so pointing this
# at <project>.web.app makes the handler same-origin. Whatever you set here must also be
# in the OAuth client's Authorized redirect URIs as https://<authDomain>/__/auth/handler
# — the auto-created client only lists the firebaseapp.com one.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-marginalia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-marginalia
VITE_FIREBASE_STORAGE_BUCKET=demo-marginalia.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Point the SDK at the local emulator suite. The demo- project prefix makes the
# emulators refuse to touch a real project, so this is safe by construction.
VITE_USE_EMULATORS=true
